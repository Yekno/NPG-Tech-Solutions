# Copy to .env for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Resend (https://resend.com) — API key and addresses for form emails.
RESEND_API_KEY=
# Address submissions are delivered to (the team inbox).
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend; until then use onboarding@resend.dev
# (Resend only delivers that to the Resend account owner's own address).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile (spam protection). These defaults are Cloudflare's official "always passes" test keys.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
