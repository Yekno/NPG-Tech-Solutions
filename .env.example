# Copy to .env for local development (.env is gitignored; never commit real keys).
# In production, set the same keys in Vercel → Project → Settings → Environment Variables.

# Resend API key (https://resend.com). Without it the forms show their error message
# and log "RESEND_API_KEY is not set" on the server instead of sending.
RESEND_API_KEY=

# Inbox that receives every form (contact, applications and Scout enquiries). Defaults to npgsolutions2026@outlook.com when empty.
CONTACT_TO_EMAIL=

# Sender address. Defaults to onboarding@resend.dev, Resend's shared test sender, because NPG has
# no verified domain yet. Resend only delivers mail from that sender to the Resend account owner's
# own address. CHANGE THIS to an address on the real domain once it is chosen and verified in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile site key (public, rendered in the page). Turnstile is only switched on
# when BOTH Turnstile keys are set; otherwise the form relies on the honeypot field alone.
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key, used server-side to verify each submission's token.
TURNSTILE_SECRET_KEY=
