---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DeveloperCard from '../components/DeveloperCard.astro';
import { ctaLinks, site } from '../data/site';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;

const services = (await getCollection('services')).sort(byOrder);
const projects = (await getCollection('projects')).sort(byOrder);
const developers = (await getCollection('developers')).sort(byOrder);
const testimonials = await getCollection('testimonials');
const featured = projects.filter((p) => p.data.featured).slice(0, 6);

// Home page images: drop files into src/assets/images/home/ named hero-1, hero-2, hero-3, about
// (jpg/png/webp/avif). Missing images fall back to a branded placeholder.
const homeImages = import.meta.glob<{ default: ImageMetadata }>('../assets/images/home/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const homeImage = (name: string) =>
  Object.entries(homeImages).find(([path]) => path.split('/').pop()?.split('.')[0] === name)?.[1].default;

const capabilities = [...services.map((s) => s.data.name), 'Responsive Design', 'SEO', 'Accessibility', 'Performance'];

const stats = [
  { value: 5, suffix: '+', label: 'Developers & designers' },
  { value: 10, suffix: '+', label: 'Projects shipped' },
  { value: services.length, suffix: '', label: 'Core services' },
];

const steps = [
  { title: 'Discover', text: 'We learn about your business, your users and what success looks like.' },
  { title: 'Design', text: 'Wireframes and visual designs you can click through before we build.' },
  { title: 'Build', text: 'The right developers from our community build it, with regular check-ins.' },
  { title: 'Launch & support', text: 'We launch, measure and keep improving — and we stay on call.' },
];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title" data-island-label="Home">
    <div class="hero__bg" aria-hidden="true">
      <span class="hero__grid"></span>
    </div>

    <div class="container hero__copy">
      <a href="/developers" class="hero__badge" data-reveal="down">
        <span class="hero__pulse" aria-hidden="true"></span>
        A community of developers<span class="hero__badge-extra">&nbsp;· Remote, worldwide</span>
        <span class="hero__badge-arrow" aria-hidden="true">›</span>
      </a>
      <h1 id="hero-title" class="h-display" data-split>
        Everything digital your business needs — <span class="text-gradient">designed, built and automated.</span>
      </h1>
      <p class="hero__lead" data-reveal="up" style="--reveal-delay:500">
        {site.name} is your one-stop digital team for web design and development, UI/UX, graphic design, video
        editing and business automation — delivered by specialists from our community.
      </p>
      <div class="hero__actions" data-reveal="up" style="--reveal-delay:650">
        <a href={ctaLinks.request.href} class="btn" data-magnetic>
          {ctaLinks.request.label} <span class="btn__arrow" aria-hidden="true">›</span>
        </a>
        <a href="/services" class="btn hero__secondary">
          Explore services <span class="btn__arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </div>

    <!-- Showcase: soft blue glow with the "Your next website" collage rising out of it -->
    <div class="hero__stage">
      <div class="hero__glow" aria-hidden="true">
        <span class="hero__glow-blob hero__glow-blob--1"></span>
        <span class="hero__glow-blob hero__glow-blob--2"></span>
        <span class="hero__glow-blob hero__glow-blob--3"></span>
      </div>

      <div class="container hero__visual-wrap">
        <a href="/portfolio" class="hero__tag" data-reveal="left" style="--reveal-delay:900">
          <span aria-hidden="true">✦</span> See our work <span aria-hidden="true">›</span>
        </a>
        <div class="hero__visual" aria-hidden="true">
          <div class="hero__frame hero__frame--main" data-reveal="up" style="--reveal-delay:700">
            <Media src={homeImage('hero-1')} alt="" label="Your next website" ratio="16 / 9" loading="eager" sizes="(min-width: 64rem) 60rem, 95vw" />
          </div>
          <div class="hero__frame hero__frame--a" data-reveal="left" style="--reveal-delay:950">
            <Media src={homeImage('hero-2')} alt="" ratio="1 / 1" loading="eager" sizes="220px" />
          </div>
          <div class="hero__frame hero__frame--b" data-reveal="right" style="--reveal-delay:1050">
            <Media src={homeImage('hero-3')} alt="" ratio="4 / 3" loading="eager" sizes="260px" />
          </div>
          <div class="hero__chip" data-reveal="up" style="--reveal-delay:1150">
            <span class="hero__chip-icon">✓</span>
            <span><strong>Mobile-first</strong><br />Fast &amp; accessible</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITIES MARQUEE ============ -->
  <div class="strip" role="region" aria-label="What we do">
    <div class="marquee">
      {
        [0, 1].map((copy) => (
          <ul role="list" class="marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {capabilities.map((c) => (
              <li>
                <span class="strip__star" aria-hidden="true">✦</span> {c}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- ============ INTRO + STATS ============ -->
  <section class="section" id="intro" aria-labelledby="intro-title">
    <div class="container intro">
      <div class="intro__media" data-reveal="mask">
        <div data-parallax="0.08">
          <Media src={homeImage('about')} alt="The NPG Tech Solutions team at work" label="Our community" ratio="5 / 6" sizes="(min-width: 64rem) 45vw, 100vw" />
        </div>
      </div>
      <div class="intro__copy">
        <p class="eyebrow" data-reveal="up">Who we are</p>
        <h2 id="intro-title" class="h-section" data-split>Your digital partner, powered by a community of experts.</h2>
        <p class="lead" data-reveal="up">
          We're a collaborative community of web developers, designers and IT specialists. Instead of one-size-fits-all,
          we match every project with the people whose skills fit it best — so you get specialist quality with a single
          point of contact.
        </p>
        <ul role="list" class="stats" data-stagger="120">
          {
            stats.map((s) => (
              <li class="stat" data-reveal="up">
                <span class="stat__value" data-count={s.value} data-suffix={s.suffix}>
                  {s.value}
                  {s.suffix}
                </span>
                <span class="stat__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="link-arrow" data-reveal="up">More about the community <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section--surface" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal="up">Services</p>
          <h2 id="services-title" class="h-section" data-split>Everything you need to grow online.</h2>
        </div>
        <a href="/services" class="btn btn--ghost" data-reveal="up">All services</a>
      </div>
      <ul role="list" class="services" data-stagger="90">
        {
          services.map((s, i) => (
            <li data-reveal="up">
              <a href={`/services#${s.id}`} class="service" data-spotlight>
                <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="service__title">{s.data.name}</h3>
                <p>{s.data.summary}</p>
                <span class="service__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section section--dark process" aria-labelledby="process-title">
    <div class="process__glow" aria-hidden="true" data-parallax="0.2"></div>
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow" data-reveal="up">How we work</p>
        <h2 id="process-title" class="h-section" data-split>From idea to launch, without the chaos.</h2>
      </div>
      <ol role="list" class="steps" data-stagger="150" data-reveal="up">
        {
          steps.map((step, i) => (
            <li class="step" data-reveal="up">
              <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ FEATURED WORK (carousel) ============ -->
  {
    featured.length > 0 && (
      <section class="section" aria-labelledby="work-title">
        <div class="container">
          <div class="section-head section-head--split">
            <div>
              <p class="eyebrow" data-reveal="up">Portfolio</p>
              <h2 id="work-title" class="h-section" data-split>Recent projects we've shipped.</h2>
            </div>
            <div class="carousel-controls" data-reveal="up">
              <button type="button" class="carousel-btn" data-carousel-prev aria-controls="work-track">
                <span aria-hidden="true">←</span>
                <span class="visually-hidden">Previous projects</span>
              </button>
              <button type="button" class="carousel-btn" data-carousel-next aria-controls="work-track">
                <span aria-hidden="true">→</span>
                <span class="visually-hidden">Next projects</span>
              </button>
            </div>
          </div>
        </div>
        <ul role="list" class="carousel" id="work-track" data-carousel tabindex="0" aria-label="Featured projects — scroll sideways">
          {featured.map((p, i) => (
            <li class="carousel__item" data-reveal="right" style={`--reveal-delay:${i * 120}`}>
              <ProjectCard project={p} index={i} />
            </li>
          ))}
        </ul>
        <div class="container center-cta" data-reveal="up">
          <a href="/portfolio" class="btn">
            View full portfolio <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ DEVELOPERS ============ -->
  <section class="section section--surface" aria-labelledby="devs-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal="up">Our developers</p>
          <h2 id="devs-title" class="h-section" data-split>Meet some of the people behind the work.</h2>
        </div>
        <a href="/developers" class="btn btn--ghost" data-reveal="up">Meet everyone</a>
      </div>
      <ul role="list" class="devs" data-stagger="120">
        {
          developers.slice(0, 4).map((d) => (
            <li data-reveal="zoom">
              <DeveloperCard developer={d} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  {
    testimonials.length > 0 && (
      <section class="section" aria-labelledby="quotes-title">
        <div class="container">
          <div class="section-head section-head--center">
            <p class="eyebrow" data-reveal="up">Testimonials</p>
            <h2 id="quotes-title" class="h-section" data-split>What our clients say.</h2>
          </div>
        </div>
        <div class="marquee quotes" style="--marquee-speed:60s">
          {[0, 1].map((copy) => (
            <ul role="list" class="marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
              {testimonials.map((t) => (
                <li>
                  <figure class="quote">
                    <span class="quote__mark" aria-hidden="true">“</span>
                    <blockquote>
                      <p>{t.data.quote}</p>
                    </blockquote>
                    <figcaption>
                      <strong>{t.data.clientName}</strong>
                      {t.data.company && <span>{t.data.company}</span>}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          ))}
        </div>
        <div class="container center-cta" data-reveal="up">
          <a href="/testimonials" class="link-arrow">
            Read all testimonials <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ JOIN BAND ============ -->
  <section class="section join" aria-labelledby="join-title">
    <div class="container">
      <div class="join__card" data-reveal="zoom" data-spotlight>
        <div>
          <p class="eyebrow">For developers</p>
          <h2 id="join-title" class="h-section">Build great things with people who care about the craft.</h2>
          <p class="lead">Join a community of developers and designers working on real client projects together.</p>
        </div>
        <a href={ctaLinks.join.href} class="btn" data-magnetic>
          {ctaLinks.join.label} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Featured-work carousel: native scroll-snap, with buttons that page through cards.
  const track = document.querySelector<HTMLElement>('[data-carousel]');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
  if (track && prev && next) {
    const step = () => (track.querySelector<HTMLElement>('.carousel__item')?.offsetWidth ?? 300) + 24;
    const behavior: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior }));
    const sync = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  /* ---------- Hero ----------
     Light, centred layout (badge, headline, lead, buttons), then a blurred blue glow
     with the showcase collage rising out of it. Built on theme tokens so it also
     works in dark mode. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-bg);
    padding-top: calc(var(--island-space) + clamp(2.5rem, 1rem + 5vw, 5rem));
    text-align: center;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000, transparent 75%);
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      border-color var(--dur-fast),
      transform var(--dur) var(--ease-out);
  }
  .hero__badge:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  @media (max-width: 30rem) {
    .hero__badge-extra {
      display: none;
    }
  }
  .hero__badge-arrow {
    transition: transform var(--dur) var(--ease-out);
  }
  .hero__badge:hover .hero__badge-arrow {
    transform: translateX(3px);
  }
  .hero__pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__pulse::after {
      animation: pulse-ring 1.8s var(--ease-out) infinite;
    }
  }
  .hero h1 {
    max-width: 20ch;
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-heading);
  }
  /* Deeper gradient so the highlight reads on a light background */
  .hero .text-gradient {
    background-image: linear-gradient(90deg, var(--color-blue), var(--color-blue-400) 50%, var(--color-blue));
  }
  :global([data-theme='dark']) .hero .text-gradient {
    background-image: linear-gradient(90deg, var(--color-blue-400), #8fb6ff 50%, var(--color-blue-400));
  }
  .hero__lead {
    max-width: 44rem;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  .hero__actions .btn {
    min-height: 3.25rem;
    padding-inline: 1.75rem;
    font-size: var(--text-base);
  }
  .hero__actions .btn:first-child {
    box-shadow: 0 12px 30px -10px rgb(6 85 225 / 0.6);
  }
  /* White pill secondary button, as in the reference */
  .hero__secondary {
    --btn-bg: var(--color-card);
    --btn-fg: var(--color-heading);
    border-color: var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .hero__secondary::before {
    background: var(--color-heading);
  }
  .hero__secondary:hover {
    color: var(--color-bg);
    border-color: var(--color-heading);
  }

  /* ----- Showcase stage ----- */
  .hero__stage {
    position: relative;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .hero__glow {
    position: absolute;
    /* Sits behind the top of the showcase so the blobs rise above it like a wave */
    inset: -3rem -8% 35% -8%;
    z-index: -1;
    pointer-events: none;
    filter: blur(clamp(30px, 4vw, 60px));
  }
  .hero__glow-blob {
    position: absolute;
    bottom: 0;
    border-radius: 50%;
  }
  .hero__glow-blob--1 {
    left: 0;
    width: 50%;
    height: 85%;
    background: radial-gradient(circle at 60% 40%, #2fb4ff, #0a6cf0 55%, transparent 72%);
  }
  .hero__glow-blob--2 {
    left: 27%;
    width: 46%;
    height: 100%;
    background: radial-gradient(circle at 50% 35%, #2a7dff, var(--color-blue) 55%, transparent 72%);
  }
  .hero__glow-blob--3 {
    right: 0;
    width: 50%;
    height: 90%;
    background: radial-gradient(circle at 40% 40%, #36c3ff, #0a6cf0 55%, transparent 72%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__glow-blob--1 {
      animation: glow-drift 14s ease-in-out infinite;
    }
    .hero__glow-blob--2 {
      animation: glow-drift 17s ease-in-out -5s infinite reverse;
    }
    .hero__glow-blob--3 {
      animation: glow-drift 15s ease-in-out -9s infinite;
    }
  }
  @keyframes glow-drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(4%, -6%) scale(1.06);
    }
    66% {
      transform: translate(-4%, 3%) scale(0.96);
    }
  }

  .hero__visual-wrap {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }
  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: clamp(0rem, 4vw, 4rem);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-navy);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out);
  }
  .hero__tag:hover {
    transform: translateX(3px);
  }
  .hero__tag span:first-child {
    color: var(--color-blue);
  }
  .hero__visual {
    position: relative;
    width: min(100%, 60rem);
    justify-self: center;
  }
  .hero__frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.35);
    box-shadow: 0 40px 80px -30px rgb(1 12 46 / 0.55);
  }
  .hero__frame--main {
    border-radius: clamp(1rem, 2vw, 1.75rem);
  }
  .hero__frame--a,
  .hero__frame--b {
    position: absolute;
  }
  .hero__frame--a {
    width: 22%;
    left: -4%;
    bottom: -8%;
  }
  .hero__frame--b {
    width: 26%;
    right: -4%;
    top: -10%;
  }
  .hero__chip {
    position: absolute;
    right: 4%;
    bottom: -6%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-navy);
    font-size: var(--text-xs);
    line-height: 1.35;
    text-align: left;
    box-shadow: var(--shadow-lg);
  }
  .hero__chip-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-blue);
    color: var(--color-white);
    font-weight: 800;
  }
  .hero__chip strong {
    font-size: var(--text-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__frame--a > :global(.media) {
      animation: float 6s ease-in-out infinite;
    }
    .hero__frame--b > :global(.media) {
      animation: float 7s ease-in-out -2s infinite;
    }
    .hero__chip {
      animation: float 5s ease-in-out -1s infinite;
    }
  }
  @media (max-width: 40rem) {
    .hero__frame--a {
      width: 30%;
      left: -2%;
    }
    .hero__frame--b {
      width: 34%;
      right: -2%;
      top: -14%;
    }
    .hero__chip {
      right: 2%;
      bottom: -12%;
      padding: var(--space-2) var(--space-3);
    }
  }

  /* ---------- Capabilities strip ---------- */
  .strip {
    padding-block: var(--space-6);
    background: var(--color-blue);
    color: var(--color-white);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .strip li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }
  .strip__star {
