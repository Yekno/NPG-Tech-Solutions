---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stages } from '../data/process';

const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- No cta prop: the footer's default closing CTA is the approved home page wording. -->
<BaseLayout
  title="How We Work"
  description="How NPG Tech Solutions runs a project, from understanding the problem through definition, planning, delivery, testing and support."
>
  <!-- ============ PAGE INTRO ============ -->
  <section class="page-hero" aria-labelledby="page-title" data-island-label="How We Work">
    <div class="page-hero__bg" aria-hidden="true"><span class="page-hero__grid"></span></div>
    <div class="container page-hero__copy">
      <p class="eyebrow" data-reveal="up">Our process</p>
      <h1 id="page-title" class="h-display" data-split>How We Work</h1>
      <p class="lead" data-reveal="up">
        A good solution begins with a clear understanding of the problem. Our process keeps the work focused, organised,
        and transparent from the first conversation to delivery.
      </p>
    </div>
  </section>

  <!-- ============ STAGES ============ -->
  <section class="section stages-section" aria-labelledby="stages-title" data-island-label="Our process">
    <div class="container">
      <h2 id="stages-title" class="visually-hidden">The six stages</h2>
      <ol role="list" class="stages" data-stagger="120">
        {
          stages.map((stage, i) => (
            <li class="stage" data-reveal="up">
              <span class="stage__num" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <h3 class="stage__title">
                <span class="visually-hidden">Stage {i + 1}: </span>
                {stage.title}
              </h3>
              <p class="stage__text">{stage.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ WORKING PRINCIPLES ============ -->
  <section class="section section--surface principles" aria-labelledby="principles-title" data-island-label="Working principles">
    <div class="container">
      <div class="principles__panel" data-reveal="up">
        <h2 id="principles-title" class="h-section">Working principles</h2>
        <p class="principles__copy">
          We communicate clearly, keep responsibilities visible, document important decisions and raise changes to
          scope, cost or schedule for approval before proceeding.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Stages ----------
     A single full-width timeline: each stage gets its own row so the description reads at a
     comfortable length. Phones: number + content, joined by a vertical line. From 48rem the
     row splits into number | title | description. */
  .stages {
    --num: 3rem;
    --row-gap: var(--space-8);
    display: grid;
    gap: var(--row-gap);
    max-width: 64rem;
    margin-inline: auto;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--num) minmax(0, 1fr);
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    align-items: start;
  }
  /* Line from this circle down to the next one */
  .stage:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--num) / 2 - 1px);
    top: calc(var(--num) + var(--space-2));
    bottom: calc(var(--space-2) - var(--row-gap));
    width: 2px;
    background: linear-gradient(to bottom, var(--color-blue), var(--color-line));
  }
  .stage__num {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: var(--num);
    height: var(--num);
    border-radius: 50%;
    background: var(--color-navy);
    border: 2px solid var(--color-blue);
    box-shadow: 0 0 0 6px rgb(6 85 225 / 0.12);
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-white);
  }
  .stage__title {
    font-size: var(--text-xl);
    color: var(--color-heading);
    /* Optically centre the first line on the circle */
    padding-top: calc((var(--num) - 1.75rem) / 2);
  }
  .stage__text {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 40rem;
  }
  @media (min-width: 48rem) {
    .stages {
      --num: 3.5rem;
      --row-gap: var(--space-12);
    }
    .stage {
      grid-template-columns: var(--num) minmax(0, 15rem) minmax(0, 1fr);
      column-gap: var(--space-8);
    }
    .stage__num {
      grid-row: auto;
    }
    .stage__text {
      padding-top: calc((var(--num) - 1.7em) / 2);
    }
  }

  /* ---------- Working principles ----------
     One panel: heading on the left, the principle statement on the right from 48rem. */
  .principles__panel {
    display: grid;
    gap: var(--space-4);
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
  }
  @media (min-width: 48rem) {
    .principles__panel {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      column-gap: var(--space-8);
      align-items: center;
    }
  }
  .principles__copy {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-text);
  }
</style>
