---
// Contact page. Rendered on demand (a Vercel Function) so the form works without JavaScript:
// it posts back here, errors re-render with the typed values kept, and success redirects to
// /contact?sent=1 (Post/Redirect/Get, so a refresh can't resubmit). With JavaScript,
// src/scripts/forms.ts submits to /api/contact instead. Both use src/lib/forms.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import FormField from '../components/FormField.astro';
import TurnstileScript from '../components/TurnstileScript.astro';
import { contact, ctaLinks } from '../data/site';
import { handlePagePost, idleForm, sentForm } from '../lib/forms';

export const prerender = false;

let state = idleForm('contact');

if (Astro.request.method === 'POST') {
  const result = await handlePagePost('contact', Astro);
  if (result.ok) return Astro.redirect('/contact?sent=1#enquiry', 303);
  state = result.state;
  Astro.response.status = result.http;
} else if (Astro.url.searchParams.get('sent') === '1') {
  state = sentForm('contact');
}

const field = { form: 'contact', state } as const;
---

<BaseLayout
  title="Contact"
  description="Get in touch with NPG Tech Solutions about a project, a technical challenge or a partnership."
  showCta={false}
>
  <!-- ============ PAGE INTRO ============ -->
  <section class="page-hero" aria-labelledby="page-title" data-island-label="Contact">
    <div class="page-hero__bg" aria-hidden="true"><span class="page-hero__grid"></span></div>
    <div class="container page-hero__copy">
      <p class="eyebrow" data-reveal="up">Let's talk</p>
      <h1 id="page-title" class="h-display" data-split>Contact NPG</h1>
      <p class="lead" data-reveal="up">
        Have a project in mind, a technical challenge to discuss or a potential partnership opportunity? Get in touch.
        Share a few details and the appropriate person at NPG will review your enquiry.
      </p>
      <!-- Contact details close the intro (like the jump links on /services). Real links, and no
           data-reveal, so they never depend on JavaScript. -->
      <h2 id="details-title" class="visually-hidden">Contact details</h2>
      <dl class="details" aria-labelledby="details-title">
        <div class="details__item">
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        </div>
        <div class="details__item">
          <dt>Telephone / WhatsApp</dt>
          <dd>
            <a href={`tel:${contact.tel}`}>{contact.phone}</a>
            <a href={contact.whatsapp} class="details__wa" target="_blank" rel="noopener noreferrer">
              Message on WhatsApp <span class="visually-hidden">(opens in a new tab)</span><span aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
        <div class="details__item">
          <dt>Operating location</dt>
          <dd>{contact.location}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ FORM ============ -->
  <section class="section contact" id="enquiry" aria-label="Enquiry form" data-island-label="Send an enquiry">
    <div class="container">
      <EnquiryForm
        form="contact"
        state={state}
        title="Send an enquiry"
        action="/contact#enquiry"
        submitLabel="Send Enquiry"
        privacy="The information you submit will be used to review and respond to your enquiry."
      >
        <div class="form__row">
          <FormField {...field} name="name" label="Full Name" autocomplete="name" />
          <FormField {...field} name="email" label="Email Address" type="email" autocomplete="email" />
        </div>
        <div class="form__row">
          <FormField
            {...field}
            name="phone"
            label="Phone / WhatsApp Number"
            placeholder="0801 234 5678"
            optional="Recommended"
            hint="Include your WhatsApp number if you'd prefer we reach you there."
          />
          <FormField {...field} name="organisation" label="Organisation / Business Name" autocomplete="organization" />
        </div>
        <div class="form__row">
          <FormField {...field} name="enquiryType" label="Enquiry Type" placeholder="Choose an enquiry type">
            <!-- The live region stays in the page; CSS shows and hides the note inside it. -->
            <div role="status">
              <p class="type-note">
                Applications and Scout enquiries go through our <a href={ctaLinks.join.href}>Join Our Team page</a>. You can
                still send a general enquiry here.
              </p>
            </div>
          </FormField>
          <FormField {...field} name="subject" label="Subject" />
        </div>
        <FormField {...field} name="message" label="Tell Us About Your Enquiry" rows={7} />
      </EnquiryForm>
    </div>
  </section>
  <TurnstileScript />
</BaseLayout>

<style>
  /* ---------- Contact details (in the intro) ----------
     Three cards in the same treatment as the jump links on /services: stacked on phones; on
     tablets the email (the longest value) takes its own row so it never breaks mid-address;
     one row of three from 64rem. */
  .details {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 60rem);
    margin: 0;
  }
  @media (min-width: 40rem) {
    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .details__item:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .details {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .details__item:first-child {
      grid-column: auto;
    }
  }
  .details__item {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
  }
  .details__item dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .details__item dd {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    margin: 0;
    font-weight: 600;
    color: var(--color-heading);
    overflow-wrap: anywhere;
  }
  .details__item dd a {
    color: var(--color-heading);
  }
  .details__item dd a:hover {
    color: var(--color-accent);
  }
  .details__item dd .details__wa {
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  /* ---------- Form ----------
     Full content width, sitting close under the intro so the page reads as one flow. */
  .contact {
    padding-top: var(--space-4);
  }

  /* ---------- Join Our Team note ----------
     Shown while one of the two join-related enquiry types is selected, without JavaScript.
     Browsers without :has() show it permanently. */
  .type-note {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-blue);
    border-radius: var(--radius-sm);
    background: var(--color-chip-bg);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  @supports selector(:has(*)) {
    .type-note {
      display: none;
    }
    :global(.field:has(option[value='Join Our Team']:checked)) .type-note,
    :global(.field:has(option[value='Business Opportunity Scout']:checked)) .type-note {
      display: block;
    }
  }
</style>
