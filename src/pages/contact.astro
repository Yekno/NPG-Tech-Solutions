---
// Contact page. Rendered on demand (a Vercel Function) so the form works without JavaScript:
// it posts back here, errors re-render with the typed values kept, and success redirects to
// /contact?sent=1 (Post/Redirect/Get, so a refresh can't resubmit). With JavaScript, the script
// below submits to /api/contact instead and shows the result inline. Both use src/lib/contact.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
import {
  ENQUIRY_TYPES,
  HONEYPOT,
  LIMITS,
  MESSAGES,
  emptyValues,
  handleEnquiry,
  turnstileSiteKey,
  type Errors,
  type FieldName,
} from '../lib/contact';

export const prerender = false;

let values = emptyValues();
let errors: Errors = {};
let status: 'idle' | 'success' | 'error' = 'idle';

if (Astro.request.method === 'POST') {
  let ip: string | undefined;
  try {
    ip = Astro.clientAddress;
  } catch {}
  const form = await Astro.request.formData().catch(() => null);
  const result = form ? await handleEnquiry(form, ip) : null;
  if (result?.status === 'success') return Astro.redirect('/contact?sent=1#enquiry', 303);
  if (result) {
    values = result.values;
    errors = result.errors;
  }
  status = 'error';
  Astro.response.status = result?.status === 'failed' ? 502 : 400;
} else if (Astro.url.searchParams.get('sent') === '1') {
  status = 'success';
}

const siteKey = turnstileSiteKey();

// Attributes shared by every field: id, required state, error wiring and server-side error state.
const fieldAttrs = (name: FieldName, isRequired = false) => ({
  id: `f-${name}`,
  name,
  required: isRequired || undefined,
  'aria-required': isRequired ? ('true' as const) : undefined,
  'aria-invalid': errors[name] ? ('true' as const) : undefined,
  'aria-describedby': errors[name] ? `f-${name}-error` : undefined,
});
---

<BaseLayout
  title="Contact"
  description="Get in touch with NPG Tech Solutions about a project, a technical challenge or a partnership."
>
  <!-- ============ PAGE INTRO ============ -->
  <section class="page-hero" aria-labelledby="page-title" data-island-label="Contact">
    <div class="page-hero__bg" aria-hidden="true"><span class="page-hero__grid"></span></div>
    <div class="container page-hero__copy">
      <p class="eyebrow" data-reveal="up">Contact</p>
      <h1 id="page-title" class="h-display" data-split>Contact NPG</h1>
      <p class="lead" data-reveal="up">
        Have a project in mind, a technical challenge to discuss or a potential partnership opportunity? Get in touch.
        Share a few details and the appropriate person at NPG will review your enquiry.
      </p>
    </div>
  </section>

  <!-- ============ DETAILS + FORM ============ -->
  <section class="section contact" id="enquiry" aria-label="Contact details and enquiry form" data-island-label="Send an enquiry">
    <div class="container contact__grid">
      <!-- Contact details: real links. No data-reveal, so they never depend on JS. -->
      <aside class="details" aria-labelledby="details-title">
        <h2 id="details-title" class="details__title">Contact details</h2>
        <dl class="details__list">
          <div class="details__item">
            <dt>Email</dt>
            <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          </div>
          <div class="details__item">
            <dt>Telephone / WhatsApp</dt>
            <dd>
              <a href={`tel:${contact.tel}`}>{contact.phone}</a>
              <a href={contact.whatsapp} class="details__wa" target="_blank" rel="noopener noreferrer">
                Message on WhatsApp <span class="visually-hidden">(opens in a new tab)</span><span aria-hidden="true">↗</span>
              </a>
            </dd>
          </div>
          <div class="details__item">
            <dt>Operating location</dt>
            <dd>{contact.location}</dd>
          </div>
        </dl>
      </aside>

      <!-- Enquiry form. Keep data-reveal off everything here: content shown after load must not
           wait for the reveal observer. -->
      <div class="form-card">
        <h2 id="form-title" class="form-card__title">Send an enquiry</h2>

        <div
          id="form-status"
          class:list={['form-status', status !== 'idle' && `form-status--${status}`]}
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden={status === 'idle'}
        >
          {status === 'success' ? MESSAGES.success : status === 'error' ? MESSAGES.error : ''}
        </div>

        <form
          class="form"
          method="POST"
          action="/contact#enquiry"
          aria-labelledby="form-title"
          data-contact-form
        >
          <p class="form__note"><span aria-hidden="true">*</span> Required field</p>

          <div class="form__row">
            <div class="field">
              <label for="f-name">Full Name <span class="field__req" aria-hidden="true">*</span></label>
              <input {...fieldAttrs('name', true)} type="text" autocomplete="name" maxlength={LIMITS.name} value={values.name} />
              <p class="field__error" id="f-name-error" hidden={!errors.name}>{errors.name}</p>
            </div>
            <div class="field">
              <label for="f-email">Email Address <span class="field__req" aria-hidden="true">*</span></label>
              <input {...fieldAttrs('email', true)} type="email" autocomplete="email" inputmode="email" maxlength={LIMITS.email} value={values.email} />
              <p class="field__error" id="f-email-error" hidden={!errors.email}>{errors.email}</p>
            </div>
          </div>

          <div class="form__row">
            <div class="field">
              <label for="f-phone">Phone Number <span class="field__opt">Optional, recommended</span></label>
              <input {...fieldAttrs('phone')} type="tel" autocomplete="tel" maxlength={LIMITS.phone} value={values.phone} />
              <p class="field__error" id="f-phone-error" hidden={!errors.phone}>{errors.phone}</p>
            </div>
            <div class="field">
              <label for="f-organisation">Organisation / Business Name <span class="field__opt">Optional</span></label>
              <input {...fieldAttrs('organisation')} type="text" autocomplete="organization" maxlength={LIMITS.organisation} value={values.organisation} />
              <p class="field__error" id="f-organisation-error" hidden={!errors.organisation}>{errors.organisation}</p>
            </div>
          </div>

          <div class="form__row">
            <div class="field">
              <label for="f-enquiryType">Enquiry Type <span class="field__req" aria-hidden="true">*</span></label>
              <select {...fieldAttrs('enquiryType', true)}>
                <option value="" selected={!values.enquiryType}>Choose an enquiry type</option>
                {ENQUIRY_TYPES.map((t) => <option value={t} selected={values.enquiryType === t}>{t}</option>)}
              </select>
              <p class="field__error" id="f-enquiryType-error" hidden={!errors.enquiryType}>{errors.enquiryType}</p>
            </div>
            <div class="field">
              <label for="f-subject">Subject <span class="field__opt">Optional</span></label>
              <input {...fieldAttrs('subject')} type="text" maxlength={LIMITS.subject} value={values.subject} />
              <p class="field__error" id="f-subject-error" hidden={!errors.subject}>{errors.subject}</p>
            </div>
          </div>

          <div class="field">
            <label for="f-message">Tell Us About Your Enquiry <span class="field__req" aria-hidden="true">*</span></label>
            <textarea {...fieldAttrs('message', true)} rows="7" maxlength={LIMITS.message}>{values.message}</textarea>
            <p class="field__error" id="f-message-error" hidden={!errors.message}>{errors.message}</p>
          </div>

          <!-- Honeypot: hidden with CSS (not type="hidden"), skipped by keyboard and screen readers.
               Real people never fill it; if it arrives filled, the server reports success and sends nothing. -->
          <div class="hp" aria-hidden="true">
            <label for="f-hp">Leave this field empty</label>
            <input id="f-hp" type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" />
          </div>

          {
            siteKey && (
              <>
                <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" />
                <noscript>
                  <p class="form__noscript">
                    Our spam check needs JavaScript. If you can't enable it, email us at{' '}
                    <a href={`mailto:${contact.email}`}>{contact.email}</a> or call{' '}
                    <a href={`tel:${contact.tel}`}>{contact.phone}</a>.
                  </p>
                </noscript>
                <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
              </>
            )
          }

          <div class="form__actions">
            <button type="submit" class="btn">
              <span class="form__label">Send Enquiry</span> <span class="btn__arrow" aria-hidden="true">→</span>
            </button>
          </div>
        </form>

        <p class="form__privacy">
          The information you submit will be used to review and respond to your enquiry. Do not submit passwords,
          payment card details or other sensitive personal information through this form.{' '}
          <a href="/privacy">Privacy Notice</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: the form already works as a plain POST. With JavaScript, validate
  // inline with the same rules as the server, submit via fetch and show the result in place.
  import { FIELDS, MESSAGES, readValues, validate, type Errors } from '../lib/contact-rules';

  declare global {
    interface Window {
      turnstile?: { reset: (el?: Element | string) => void };
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.getElementById('form-status');

  if (form && status) {
    form.noValidate = true; // our inline errors replace the browser's bubbles
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector<HTMLElement>('.form__label')!;

    const fieldEl = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);

    const setError = (name: string, message?: string) => {
      const el = fieldEl(name);
      const err = document.getElementById(`f-${name}-error`);
      if (!el || !err) return;
      if (message) {
        err.textContent = message;
        err.hidden = false;
        el.setAttribute('aria-invalid', 'true');
        el.setAttribute('aria-describedby', err.id);
      } else {
        err.textContent = '';
        err.hidden = true;
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      }
    };

    const showErrors = (errors: Errors) => {
      FIELDS.forEach((name) => setError(name, errors[name]));
    };

    const showStatus = (kind: 'success' | 'error') => {
      status.textContent = kind === 'success' ? MESSAGES.success : MESSAGES.error;
      status.className = `form-status form-status--${kind}`;
      status.hidden = false;
    };

    const focusFirstInvalid = (errors: Errors) => {
      const first = FIELDS.find((name) => errors[name]);
      if (first) fieldEl(first)?.focus();
      else status.focus();
    };

    // Clear a field's error as soon as it's corrected.
    form.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name && target.getAttribute('aria-invalid') === 'true') {
        const errors = validate(readValues(new FormData(form)));
        setError(target.name, errors[target.name as keyof Errors]);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const errors = validate(readValues(data));
      showErrors(errors);
      if (Object.keys(errors).length > 0) {
        showStatus('error');
        focusFirstInvalid(errors);
        return;
      }

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      label.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = (await res.json()) as { status: string; errors?: Errors };
        if (json.status === 'success') {
          form.reset();
          showErrors({});
          showStatus('success');
          status.focus();
        } else {
          // Keep everything the user typed.
          showErrors(json.errors ?? {});
          showStatus('error');
          focusFirstInvalid(json.errors ?? {});
        }
      } catch {
        showStatus('error');
        status.focus();
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        label.textContent = 'Send Enquiry';
        // Turnstile tokens are single-use: get a fresh one for any further attempt.
        window.turnstile?.reset();
      }
    });
  }
</script>

<style>
  /* ---------- Layout ----------
     Phones and tablets: details, then the form. From 56rem: details on the left, form on the right. */
  .contact__grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-12);
    }
    .details {
      position: sticky;
      top: calc(var(--island-space) + var(--space-4));
    }
  }

  /* ---------- Contact details ---------- */
  .details {
    display: grid;
    gap: var(--space-6);
  }
  .details__title,
  .form-card__title {
    font-size: var(--text-xl);
    color: var(--color-heading);
  }
  .details__list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
  }
  .details__item {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-blue);
  }
  .details__item dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .details__item dd {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    margin: 0;
    font-weight: 600;
    color: var(--color-heading);
    overflow-wrap: anywhere;
  }
  .details__item dd a {
    color: var(--color-heading);
  }
  .details__item dd a:hover {
    color: var(--color-accent);
  }
  .details__item dd .details__wa {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ---------- Form card ---------- */
  .form-card {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
  }
  .form {
    display: grid;
    gap: var(--space-6);
  }
  .form__note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .form__note span,
  .field__req {
    color: var(--color-error);
    font-weight: 700;
  }
  .form__row {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 40rem) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Fields ---------- */
  .field {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .field label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-heading);
  }
  .field__opt {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem; /* 16px+ stops iOS zooming into the field */
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }
  .field textarea {
    resize: vertical;
    min-height: 10rem;
    line-height: 1.6;
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--color-muted);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
    border-color: var(--color-blue);
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-error);
    box-shadow: 0 0 0 1px var(--color-error);
  }
  .field__error {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-error);
  }
  .field__error::before {
    content: '! ';
  }
  :global([data-theme='dark']) .field__error,
  :global([data-theme='dark']) .field__req,
  :global([data-theme='dark']) .form__note span {
    color: #ff8a80;
  }
  :global([data-theme='dark']) .field [aria-invalid='true'] {
    border-color: #ff8a80;
    box-shadow: 0 0 0 1px #ff8a80;
  }

  /* Honeypot: off-screen, not display:none (some bots skip hidden fields) */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---------- Status message ---------- */
  .form-status {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius);
    border: 1px solid;
    font-weight: 600;
    line-height: 1.6;
  }
  .form-status[hidden] {
    display: none;
  }
  .form-status--success {
    border-color: var(--color-success);
    background: rgb(27 127 75 / 0.08);
    color: var(--color-success);
  }
  .form-status--error {
    border-color: var(--color-error);
    background: rgb(198 40 40 / 0.07);
    color: var(--color-error);
  }
  :global([data-theme='dark']) .form-status--success {
    border-color: #5fd39a;
    background: rgb(95 211 154 / 0.1);
    color: #8ee6b8;
  }
  :global([data-theme='dark']) .form-status--error {
    border-color: #ff8a80;
    background: rgb(255 138 128 / 0.1);
    color: #ffb4ab;
  }

  .form__actions .btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .form__noscript {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .form__privacy {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-muted);
  }
  .form__privacy a {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
