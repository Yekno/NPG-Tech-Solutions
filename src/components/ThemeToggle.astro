---
/*
 * Light/dark switch. The initial theme is applied by the inline script in BaseLayout
 * before first paint; this button flips it, remembers the choice, and plays a
 * circular reveal from the button where View Transitions are supported.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
  <span class="visually-hidden">Dark mode</span>
  <svg class="theme-toggle__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <mask id="theme-toggle-moon">
      <rect x="0" y="0" width="24" height="24" fill="white"></rect>
      <circle class="theme-toggle__cut" cx="24" cy="4" r="7" fill="black"></circle>
    </mask>
    <circle class="theme-toggle__core" cx="12" cy="12" r="5.5" mask="url(#theme-toggle-moon)" fill="currentColor"></circle>
    <g class="theme-toggle__rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="1.5" x2="12" y2="3.5"></line>
      <line x1="12" y1="20.5" x2="12" y2="22.5"></line>
      <line x1="1.5" y1="12" x2="3.5" y2="12"></line>
      <line x1="20.5" y1="12" x2="22.5" y2="12"></line>
      <line x1="4.6" y1="4.6" x2="6" y2="6"></line>
      <line x1="18" y1="18" x2="19.4" y2="19.4"></line>
      <line x1="4.6" y1="19.4" x2="6" y2="18"></line>
      <line x1="18" y1="6" x2="19.4" y2="4.6"></line>
    </g>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(dark)));
    themeMeta?.setAttribute('content', dark ? '#040a1c' : '#021854');
  };

  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* storage unavailable (private mode etc.) — theme still applies for this page */
    }
    sync();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      if (!document.startViewTransition || reduceMotion.matches) {
        apply(next);
        return;
      }
      const r = button.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      const transition = document.startViewTransition(() => apply(next));
      transition.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 650, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
    });
  });

  // Follow the device setting until the visitor makes their own choice.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {}
    if (!saved) {
      root.dataset.theme = e.matches ? 'dark' : 'light';
      sync();
    }
  });

  sync();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--color-white);
    transition:
      background var(--dur-fast),
      transform var(--dur-fast);
  }
  .theme-toggle:hover {
    background: rgb(255 255 255 / 0.18);
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }

  /* Sun ↔ moon morph */
  .theme-toggle__icon {
    transition: transform 600ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .theme-toggle__core {
    transition: r 500ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .theme-toggle__cut {
    transition:
      cx 500ms cubic-bezier(0.34, 1.4, 0.64, 1),
      cy 500ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .theme-toggle__rays {
    transform-origin: center;
    transition:
      opacity 300ms,
      transform 500ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  :global([data-theme='dark']) .theme-toggle__icon {
    transform: rotate(-30deg);
  }
  :global([data-theme='dark']) .theme-toggle__core {
    r: 8.5px;
  }
  :global([data-theme='dark']) .theme-toggle__cut {
    cx: 17px;
    cy: 7px;
  }
  :global([data-theme='dark']) .theme-toggle__rays {
    opacity: 0;
    transform: scale(0.5) rotate(45deg);
  }
</style>
