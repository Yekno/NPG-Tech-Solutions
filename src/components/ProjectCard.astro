---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
const { title, type, summary, tech, images } = project.data;
---

<article class="project-card card-lift zoom-media">
  <Media
    src={images[0]}
    alt={images[0] ? `Screenshot of ${title}` : `${title} — image coming soon`}
    label={title}
    ratio="16 / 11"
    sizes="(min-width: 64rem) 40vw, 85vw"
  />
  <div class="project-card__body">
    <div class="project-card__meta">
      {index !== undefined && <span class="project-card__num">{String(index + 1).padStart(2, '0')}</span>}
      <span class="tag">{type}</span>
    </div>
    <h3 class="project-card__title">
      <a href={`/portfolio/${project.id}`}>{title}</a>
    </h3>
    <p>{summary}</p>
    <ul role="list" class="project-card__tech" aria-label="Technologies used">
      {tech.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-card);
    color: var(--color-text);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .project-card__body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
  }
  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .project-card__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 700;
  }
  .project-card__title {
    font-size: var(--text-xl);
  }
  .project-card__title a {
    color: var(--color-heading);
    text-decoration: none;
  }
  /* Whole card is clickable via the title link */
  .project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-card__title a:focus-visible {
    outline: none;
  }
  .project-card:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .project-card p {
    color: var(--color-muted);
  }
  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-heading);
  }
  .project-card__tech li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
</style>
