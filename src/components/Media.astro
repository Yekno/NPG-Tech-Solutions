---
/*
 * Renders an optimised image, or a branded animated placeholder when no image
 * has been added to the content entry yet.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  label?: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  label,
  ratio = '4 / 3',
  widths = [400, 800, 1200],
  sizes = '(min-width: 64rem) 33vw, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<div class:list={['media', className]} style={`--ratio:${ratio}`}>
  {
    src ? (
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    ) : (
      <div class="media__placeholder" role="img" aria-label={alt}>
        <span class="media__grid" aria-hidden="true" />
        <span class="media__orb" aria-hidden="true" />
        {label && <span class="media__label" aria-hidden="true">{label}</span>}
      </div>
    )
  }
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: inherit;
    background: var(--color-navy);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .media__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(6 85 225 / 0.65), transparent 60%),
      linear-gradient(160deg, var(--color-navy-800), var(--color-navy-900));
    transition: transform 900ms var(--ease-out);
  }
  .media__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at 70% 30%, #000, transparent 75%);
  }
  .media__orb {
    position: absolute;
    width: 45%;
    aspect-ratio: 1;
    right: 10%;
    top: 12%;
    border-radius: 50%;
    border: 1px dashed rgb(169 196 250 / 0.5);
  }
  .media__orb::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    top: -5px;
    left: calc(50% - 5px);
    border-radius: 50%;
    background: var(--color-blue-400);
    box-shadow: 0 0 16px var(--color-blue-400);
  }
  @media (prefers-reduced-motion: no-preference) {
    .media__orb {
      animation: spin-slow 14s linear infinite;
    }
  }
  .media__label {
    position: relative;
    padding: var(--space-2) var(--space-4);
    font-weight: 800;
    font-size: var(--text-xl);
    color: var(--color-white);
    letter-spacing: -0.02em;
    text-align: center;
  }
  /* Parent cards can opt into a zoom-on-hover by adding .zoom-media */
  :global(.zoom-media:hover) .media img,
  :global(.zoom-media:hover) .media__placeholder {
    transform: scale(1.06);
  }
</style>
